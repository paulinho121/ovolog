# Copie para `.env` e preencha.
#
# Ambos os valores estão em: Supabase → Project Settings → API.
# A chave anon é pública (vai no bundle do navegador); quem protege os dados
# é o Row Level Security. Nunca coloque a service_role aqui — ela ignora RLS
# e não pode chegar ao cliente.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

APP_URL=http://localhost:3000
